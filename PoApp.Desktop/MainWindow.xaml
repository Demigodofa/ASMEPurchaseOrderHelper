<Window x:Class="PoApp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASME PO Assistant"
        Height="900"
        Width="1400"
        MinHeight="720"
        MinWidth="1100">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="520" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Purchase Order Context" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />

                <CheckBox Content="B16 item (flange / valve / fitting / forging / casting)"
                          IsChecked="{Binding IsB16Item, Mode=TwoWay}"
                          Margin="0,0,0,8" />

                <Grid Margin="0,0,0,10">
                    <ComboBox ItemsSource="{Binding B16Standards}"
                              SelectedItem="{Binding SelectedB16Standard, Mode=TwoWay}"
                              IsEnabled="{Binding IsB16Item}"
                              Width="90"
                              HorizontalContentAlignment="Center"
                              ToolTip="{Binding SelectedB16Standard.Description}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Code}" ToolTip="{Binding Description}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <CheckBox Content="MTR (CofC) Required"
                          IsChecked="{Binding MtrRequired}"
                          IsEnabled="False"
                          Margin="0,0,0,6" />
                <TextBlock Text="{Binding PolicyStatus}"
                           TextWrapping="Wrap"
                           Foreground="#444"
                           FontSize="12"
                           Margin="0,0,0,14" />

                <TextBlock Text="Material Selector" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,10" />

                <TextBlock Text="Spec System" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding SpecSystems}"
                          SelectedItem="{Binding SelectedSpecSystem, Mode=TwoWay}"
                          DisplayMemberPath="Display"
                          Margin="0,6,0,10" />

                <TextBlock Text="Material Spec" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding MaterialSpecs}"
                          SelectedItem="{Binding SelectedMaterialSpec, Mode=TwoWay}"
                          DisplayMemberPath="SpecDisplay"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          Margin="0,6,0,10" />
                <TextBlock Text="{Binding MaterialSpecWarning}"
                           TextWrapping="Wrap"
                           Foreground="#B85C00"
                           FontSize="11"
                           Margin="0,0,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MaterialSpecWarning}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MaterialSpecWarning}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Grade" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding GradeOptions}"
                          SelectedItem="{Binding SelectedGrade, Mode=TwoWay}"
                          Margin="0,6,0,10">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowGradeSelector}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <TextBlock Text="Class" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding ClassOptions}"
                          SelectedItem="{Binding SelectedClass, Mode=TwoWay}"
                          Margin="0,6,0,10">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowClassSelector}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <TextBlock Text="UNS Typeahead" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding UnsCandidates}"
                          SelectedItem="{Binding SelectedUnsCandidate, Mode=TwoWay}"
                          DisplayMemberPath="Display"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          TextSearch.TextPath="Uns"
                          Margin="0,6,0,10" />

                <TextBlock Text="UNS" FontWeight="SemiBold" />
                <TextBox Text="{Binding UnsNumber}" IsReadOnly="True" Margin="0,6,0,10" />

                <TextBlock Text="Title" FontWeight="SemiBold" />
                <TextBox Text="{Binding TitleDisplay}" IsReadOnly="True" Margin="0,6,0,10" />

                <TextBlock Text="ASTM Equivalency" FontWeight="SemiBold" />
                <TextBox Text="{Binding AstmEquivalencyInfo}" IsReadOnly="True" Margin="0,6,0,10" />

                <TextBlock Text="Ordering Requirements" FontWeight="SemiBold" Margin="0,6,0,6" />
                <TextBlock Text="{Binding ValidationStatus}"
                           TextWrapping="Wrap"
                           Foreground="#666"
                           FontSize="12"
                           Margin="0,0,0,8" />

                <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="8">
                    <ItemsControl ItemsSource="{Binding OrderingFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E2E2" BorderThickness="0,0,0,1" Padding="0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding RequiredHint}" FontSize="11" Foreground="#666" Margin="0,2,0,4" />
                                        <TextBlock Text="Fixed text (included as-is)."
                                                   FontSize="11"
                                                   Foreground="#666"
                                                   Margin="0,0,0,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFixedText}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UsesTextInput}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <ComboBox ItemsSource="{Binding Options}"
                                                  SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                  Margin="0,2,0,0">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSingleSelectOptions}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>

                                        <ComboBox ItemsSource="{Binding Options}"
                                                  SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                  IsEditable="True"
                                                  Margin="0,2,0,0">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasEditableSelectOptions}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>

                                        <CheckBox Content="Selected"
                                                  IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                                  Margin="0,2,0,0">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="IsThreeState" Value="True" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>

                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0"
                                                     Text="{Binding NumberValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding Units}"
                                                      SelectedItem="{Binding SelectedUnit, Mode=TwoWay}" />
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNumberWithUnit}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding MultiSelectOptions}" Margin="0,2,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Value}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Margin="0,2,0,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMultiSelect}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding Note}"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="#666"
                                                   Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasNote}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Regenerate" Command="{Binding RegenerateCommand}" Padding="12,8" Margin="0,0,8,0" />
                    <Button Content="Export" Command="{Binding ExportCommand}" Padding="12,8" Margin="0,0,8,0" />
                    <Button Content="Copy" Command="{Binding CopyToClipboardCommand}" Padding="12,8" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="2" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel>
                <TextBlock Text="Purchase Order Output" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBox Text="{Binding GeneratedText}"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         FontFamily="Consolas"
                         FontSize="13"
                         Height="760" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
