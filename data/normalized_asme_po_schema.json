{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASME PO Assistant Normalized JSONL Schema",
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "record_type": {
          "const": "global_policy"
        },
        "policy_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "inputs_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "enums": {
          "type": "object"
        }
      },
      "required": [
        "record_type",
        "policy_id",
        "rules"
      ]
    },
    {
      "properties": {
        "record_type": {
          "const": "spec_definition"
        },
        "asme_spec": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "astm_identical": {
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ordering_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "prompt": {
                "type": "string"
              },
              "input_type": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "required_when": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "options": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "units": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "prompt",
              "input_type",
              "required"
            ]
          }
        },
        "purchase_order_flags": {
          "type": "object"
        },
        "supplementary_requirements_catalog": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "record_type",
        "asme_spec",
        "ordering_fields"
      ]
    }
  ]
}